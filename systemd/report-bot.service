[Unit]
Description=Weekly report bot server, setup pages, gateway and hosted teams
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
ExecStart=/opt/report-bot/report-bot-app --server --data /opt/report-bot/data
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
